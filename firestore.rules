rules_version = '2';
// TN-170 Firestore rules
//
// V1 access model — public self-signup + manual squadron-leadership approval:
//   - Anyone can sign up via Firebase Auth and create their own
//     profiles/{uid} document with role="senior_member" and
//     status="awaiting_approval" (no invite required).
//   - The optional legacy invite-link flow is still supported.
//   - Approval / role assignment is performed by an admin or commander on
//     admin.html, which updates status to "active" (or "denied") and writes
//     to the auditLog collection.
//   - Approved members (status in ['active','approved']) can read shared
//     portal data; admins/commanders can read pending profiles.
//   - Users may only update a whitelisted set of fields on their own profile;
//     role, status, approved, isAdmin, accountStatus, portalRole, etc. are
//     server-managed and cannot be self-mutated.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function profile() {
      return get(/databases/$(database)/documents/profiles/$(uid())).data;
    }

    function isApproved() {
      return signedIn()
        && profile().status in ['approved', 'active'];
    }

    function isApprovalAdmin() {
      return isApproved()
        && profile().role in ['commander', 'admin'];
    }

    function isAdmin() {
      return isApprovalAdmin();
    }

    function approvedMember() {
      return isApproved();
    }

    function adminMember() {
      return isAdmin();
    }

    function inviteNotExpired(data) {
      return !('expiresAt' in data) || data.expiresAt == null || data.expiresAt > request.time;
    }

    // Public self-signup: signed-in user may create their own profile with
    // hardcoded server-managed defaults. Never accepts role/status overrides
    // from the client beyond the values listed here. Optional invite token
    // may be recorded via createdFromInviteId but is not required.
    function validSelfSignup(userId) {
      let data = request.resource.data;
      let baseKeys = [
        'email','firstName','lastName','preferredName',
        'capId','rank','phone','dutyPosition','accessNote',
        'role','status','createdAt','updatedAt'
      ];
      let allKeys = baseKeys.concat(['createdFromInviteId']);
      return signedIn()
        && userId == uid()
        && data.role == 'senior_member'
        && data.status == 'awaiting_approval'
        && data.email == request.auth.token.email
        && data.keys().hasOnly(allKeys)
        && data.keys().hasAll(['email','firstName','lastName','capId','rank','role','status']);
    }

    function safeProfilePatch() {
      let allowed = ['firstName', 'lastName', 'preferredName', 'rank', 'capId', 'phone', 'dutyPosition', 'profilePhotoUrl', 'updatedAt'];
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    function adminProfileApprovalUpdate() {
      let keys = request.resource.data.diff(resource.data).affectedKeys();
      let statusOk = request.resource.data.status in ['active', 'denied'];
      let approveOk = request.resource.data.status == 'active'
        && keys.hasOnly(['status', 'role', 'approvedAt', 'approvedBy', 'updatedAt']);
      let denyOk = request.resource.data.status == 'denied'
        && keys.hasOnly(['status', 'deniedAt', 'deniedBy', 'updatedAt']);
      return statusOk && (approveOk || denyOk);
    }

    function inviteMarkUsed() {
      return signedIn()
        && resource.data.status == 'unused'
        && request.resource.data.status == 'used'
        && request.resource.data.usedBy == uid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'usedAt', 'usedBy']);
    }

    match /users/{userId} {
      allow read: if signedIn() && userId == uid();
      allow write: if false;
    }

    match /profiles/{userId} {
      // Read: own profile OR approval admin (so admins can see pending list).
      allow read: if signedIn() && (userId == uid() || isApprovalAdmin());

      // Create: signed-in user may create their own profile with role
      // "senior_member" and status "awaiting_approval" (public signup path).
      allow create: if validSelfSignup(userId);

      // Update: owner may patch a whitelisted set of editable fields
      // (NEVER role/status/approved/isAdmin/accountStatus/portalRole).
      allow update: if signedIn() && userId == uid() && safeProfilePatch();

      // Update: approval admins may flip status (with role) on approve, or
      // set denied state on deny. Any other field change is rejected.
      allow update: if isApprovalAdmin() && adminProfileApprovalUpdate();

      allow delete: if isApprovalAdmin();
    }

    match /inviteLinks/{inviteId} {
      allow read: if resource.data.status == 'unused' && inviteNotExpired(resource.data);
      allow read: if isApprovalAdmin();
      allow create: if isApprovalAdmin()
        && request.resource.data.status == 'unused'
        && request.resource.data.token == inviteId;
      allow update: if inviteMarkUsed();
      allow delete: if isApprovalAdmin();
    }

    match /uploadedFiles/{docId} {
      allow read: if isApproved();
      allow create: if isApproved() && request.resource.data.ownerId == uid();
      allow update, delete: if isApproved();
    }

    match /importJobs/{docId} {
      allow read: if isApproved();
      allow create: if isApproved();
      allow update: if isApproved();
    }

    match /parsedDocuments/{docId} {
      allow read: if isApproved();
      allow create: if isApproved();
    }

    match /meetings/{docId} {
      allow read: if isApproved();
      allow create, update: if isApproved();
      allow delete: if isApprovalAdmin();
    }

    match /tasks/{docId} {
      allow read: if isApproved();
      allow create, update: if isApproved();
      allow delete: if isApprovalAdmin();
    }

    match /flightReviews/{docId} {
      allow read: if isApproved();
      allow create, update: if isApproved();
      allow delete: if isApprovalAdmin();
    }

    match /inspectionItems/{docId} {
      allow read: if isApproved();
      allow create, update: if isApproved();
      allow delete: if isApprovalAdmin();
    }

    match /orgPositions/{docId} {
      allow read: if isApproved();
      allow create, update: if isApproved();
      allow delete: if isApprovalAdmin();
    }

    match /schedules/{docId} {
      allow read: if isApproved();
      allow create, update: if isApproved();
      allow delete: if isApprovalAdmin();
    }

    match /stewardConversations/{docId} {
      allow read, write: if isApproved() && resource.data.profileId == uid();
      allow create: if isApproved() && request.resource.data.profileId == uid();
    }

    match /stewardMessages/{docId} {
      allow read, write: if isApproved() && request.resource.data.profileId == uid();
      allow create: if isApproved() && request.resource.data.profileId == uid();
    }

    match /auditLog/{docId} {
      allow read: if isApprovalAdmin();
      // Approval admins always write audit entries (approve / deny).
      // Approved members may also write audit entries for their own actions.
      allow create: if isApprovalAdmin()
        || (isApproved() && request.resource.data.actorId == uid());
    }

    match /resourceLinks/{id} {
      allow read, create, update: if approvedMember();
      allow delete: if adminMember();
    }
  }
}
